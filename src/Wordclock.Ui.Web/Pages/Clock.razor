@page "/"
@page "/clock"

<h3>Uhr</h3>

<div class="container-fluid">
    <div class="row">
        <div class="col-1">Status</div>
        <div class="col-11">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" checked="@ClockIsActive" disabled="@ClockIsActive" @onchange="OnClockStatusToggled"/>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-1">Farbe</div>
        <div class="col-11">
            <input class="form-control form-control-color" type="color" value="@GetClockColor()" @onchange="OnColorChanged"/>
        </div>
    </div>
</div>

