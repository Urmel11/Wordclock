[Unit]
Description=Wordclock service

[Service]
ExecStart=/home/raspberry/clock/Wordclock.Ui.Web
WorkingDirectory=/home/raspberry/clock
User=rasbperry
Group=rasbperry

[Install]
WantedBy=multi-user.target

#Copy this file to /etc/systemd/system and execute below commands
#sudo systemctl enable clock.service #enables autostart
#sudo systemctl start clock.service #runs now
#sudo systemctl status clock.service #checks status

